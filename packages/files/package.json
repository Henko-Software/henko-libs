{
	"name": "@henko-software/files",
	"version": "0.1.0",
	"description": "Archivos detrás de un puerto: disco local en desarrollo, bucket S3-compatible por config, memoria en tests.",
	"license": "UNLICENSED",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Henko-Software/henko-libs.git",
		"directory": "packages/files"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"henko-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"aws4fetch": "^1.0.20",
		"zod": "^4.1.0"
	}
}
