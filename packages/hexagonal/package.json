{
	"name": "@henko-software/hexagonal",
	"version": "0.1.1",
	"description": "Base de casos de uso y puertos comunes (auditoría, eventos, transacciones, reloj).",
	"license": "UNLICENSED",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Henko-Software/henko-libs.git",
		"directory": "packages/hexagonal"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"henko-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@henko-software/tracing": "workspace:^"
