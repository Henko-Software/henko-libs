{
	"name": "@henko-software/tracing-node",
	"version": "0.1.0",
	"description": "Arranque de OpenTelemetry en un servicio Node: autoinstrumentación y envío OTLP.",
	"license": "UNLICENSED",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Henko-Software/henko-libs.git",
		"directory": "packages/tracing-node"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"henko-source": "./src/index.ts",
